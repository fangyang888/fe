# Transformers.js is the built-in default. No API key or model service is
# required. These are optional overrides; this file is not loaded automatically.
# COMPONENT_MCP_EMBEDDING_PROVIDER=transformers-js
# COMPONENT_MCP_EMBEDDING_MODEL=Xenova/multilingual-e5-small
# COMPONENT_MCP_EMBEDDING_MODEL_REVISION=761b726dd34fb83930e26aab4e9ac3899aa1fa78
# COMPONENT_MCP_EMBEDDING_DIMENSIONS=384
# COMPONENT_MCP_EMBEDDING_BATCH_SIZE=16
# COMPONENT_MCP_TRANSFORMERS_DTYPE=q8
# COMPONENT_MCP_MODEL_CACHE_PATH=/absolute/path/to/model-cache
# COMPONENT_MCP_MODEL_HUB_URL=https://hf-mirror.com/
# To use the official model hub instead:
# COMPONENT_MCP_MODEL_HUB_URL=https://huggingface.co/

# Streamable HTTP server. This entry point intentionally has no built-in
# authentication or Host validation; expose it only on a trusted network or
# put access control in a reverse proxy/API gateway.
# COMPONENT_MCP_HTTP_HOST=0.0.0.0
# COMPONENT_MCP_HTTP_PORT=3102
# PORT=3102

# Optional Ollama switch. Start Ollama and use settings compatible with the
# selected model.
# COMPONENT_MCP_EMBEDDING_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_KEEP_ALIVE=5m

# Optional OpenAI switch. Inject the key through a secret manager and use a
# compatible model/dimensions pair.
# COMPONENT_MCP_EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
