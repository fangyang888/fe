body,page{-webkit-font-smoothing:antialiased;background:#f7f6f2;color:#29332e;font-family:-apple-system,BlinkMacSystemFont,PingFang SC,Helvetica Neue,sans-serif;font-size:28rpx;line-height:1.5}button,input,scroll-view,text,textarea,view{-webkit-box-sizing:border-box;box-sizing:border-box}button{font-family:inherit;font-weight:500}button::after{border:0}input,textarea{font-family:inherit}.u-card{background:#fff;border-radius:28rpx}.u-ellipsis-1{-webkit-line-clamp:1;-webkit-box-orient:vertical;display:-webkit-box;overflow:hidden;text-overflow:ellipsis}.u-ellipsis-2{-webkit-line-clamp:2;-webkit-box-orient:vertical;display:-webkit-box;overflow:hidden;text-overflow:ellipsis}.loading{color:#6d7971;font-size:28rpx;padding:140rpx 32rpx;text-align:center}.section-caption{color:#253d34;display:block;font-size:28rpx;font-weight:600;margin-bottom:24rpx}@media (prefers-reduced-motion:reduce){button,view{-webkit-animation:none!important;animation:none!important;-webkit-transition:none!important;transition:none!important}}@import "./common.wxss";