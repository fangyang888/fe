.address-edit-page{background:#f7f6f2;min-height:100vh;padding:0 32rpx 48rpx}.form-card{background:#fff;border:1rpx solid #e5e7df;border-radius:28rpx;padding:0 32rpx}.form-row{-ms-flex-align:center;-webkit-align-items:center;align-items:center;border-bottom:1rpx solid #e5e7df;display:-webkit-flex;display:-ms-flexbox;display:flex;gap:24rpx;min-height:108rpx;padding:20rpx 0}.form-row:last-child{border:0}.label{-ms-flex-negative:0;color:#253d34;-webkit-flex-shrink:0;flex-shrink:0;font-size:28rpx;width:132rpx}.input{-webkit-flex:1;-ms-flex:1;flex:1;font-size:28rpx;height:68rpx;line-height:1.5;min-width:0}.switch-row{-ms-flex-pack:justify;-webkit-justify-content:space-between;justify-content:space-between}.switch-row .label{width:auto}.save-btn{-ms-flex-align:center;-ms-flex-pack:center;-webkit-align-items:center;align-items:center;background:#244a3d;border-radius:20rpx;color:#fff;display:-webkit-flex;display:-ms-flexbox;display:flex;font-size:28rpx;font-weight:500;-webkit-justify-content:center;justify-content:center;margin:32rpx 0;min-height:88rpx;padding:0 32rpx;-webkit-transition:opacity .16s ease;transition:opacity .16s ease}.save-btn:active{opacity:.7}.save-text{font-size:28rpx}