.address-list-page{background:#f7f6f2;min-height:100vh;padding:0 32rpx calc(160rpx + env(safe-area-inset-bottom))}.address-list-page .addr-info{-webkit-flex:1;-ms-flex:1;flex:1;min-width:0}.address-list-page .addr-line1{-ms-flex-align:center;-webkit-align-items:center;align-items:center;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-wrap:wrap;-ms-flex-wrap:wrap;flex-wrap:wrap;gap:20rpx;margin-bottom:16rpx}.address-list-page .addr-name{color:#253d34;font-size:30rpx;font-weight:600}.address-list-page .addr-phone{color:#6d7971;font-size:26rpx}.address-list-page .addr-detail{color:#6d7971;display:block;font-size:26rpx;line-height:1.7;word-break:break-word}.addr-card{background:#fff;border:1rpx solid #e5e7df;border-radius:28rpx;margin-bottom:24rpx;padding:32rpx}.default-tag{background:#eaf0e8;border-radius:24rpx;margin-left:auto;padding:6rpx 16rpx}.default-tag-text{color:#244a3d;font-size:20rpx}.addr-actions{-ms-flex-align:center;-webkit-align-items:center;align-items:center;border-top:1rpx solid #e5e7df;display:-webkit-flex;display:-ms-flexbox;display:flex;gap:28rpx;margin-top:28rpx;padding-top:24rpx}.action-btn{color:#244a3d;font-size:24rpx;padding:4rpx 8rpx}.action-btn:first-child{-webkit-flex:1;-ms-flex:1;flex:1}.action-btn.danger{color:#a45442}.add-btn{-ms-flex-align:center;-ms-flex-pack:center;-webkit-align-items:center;align-items:center;background:#244a3d;border-radius:20rpx;bottom:calc(28rpx + env(safe-area-inset-bottom));color:#fff;display:-webkit-flex;display:-ms-flexbox;display:flex;font-size:28rpx;font-weight:500;-webkit-justify-content:center;justify-content:center;left:32rpx;min-height:88rpx;padding:0 32rpx;position:fixed;right:32rpx;-webkit-transition:opacity .16s ease;transition:opacity .16s ease;z-index:20}.add-btn:active{opacity:.7}.add-text{font-size:28rpx}