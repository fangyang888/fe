.coupon-page{background:#f7f6f2;min-height:100vh;padding:0 32rpx 48rpx}.tabs{border-bottom:1rpx solid #e5e7df;display:-webkit-flex;display:-ms-flexbox;display:flex;margin-bottom:28rpx;white-space:nowrap}.tabs .tab-item{-ms-flex-pack:center;color:#6d7971;display:-webkit-inline-flex;display:-ms-inline-flexbox;display:inline-flex;-webkit-flex:1;-ms-flex:1;flex:1;font-size:26rpx;-webkit-justify-content:center;justify-content:center;padding:24rpx 20rpx;position:relative}.tabs .tab-item.active{color:#244a3d;font-weight:600}.tabs .tab-item.active::after{background:#244a3d;border-radius:5rpx;bottom:0;content:"";height:5rpx;left:26%;position:absolute;right:26%}.coupon-card{background:#fff;border:1rpx solid #e5e7df;border-radius:28rpx;display:-webkit-flex;display:-ms-flexbox;display:flex;margin-bottom:24rpx;min-height:200rpx;overflow:hidden}.coupon-left{-ms-flex-align:center;-ms-flex-pack:center;-ms-flex-negative:0;-webkit-align-items:center;align-items:center;background:#a66845;border-right:2rpx dashed #ead6c9;color:#fff;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;-webkit-flex-shrink:0;flex-shrink:0;-webkit-justify-content:center;justify-content:center;padding:28rpx 16rpx;width:220rpx}.coupon-value{font-family:DIN Alternate,sans-serif;font-size:56rpx;font-weight:600}.coupon-min{font-size:24rpx;margin-top:6rpx}.coupon-right{-ms-flex-pack:center;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;-webkit-justify-content:center;justify-content:center;min-width:0;padding:32rpx 28rpx}.coupon-name{color:#253d34;font-size:29rpx;font-weight:500}.coupon-expire{color:#8b958e;font-size:22rpx;margin-top:16rpx}.coupon-card.disabled .coupon-left{background:#a8aea5;border-color:#e5e7df}.coupon-card.disabled .coupon-name{color:#6d7971}