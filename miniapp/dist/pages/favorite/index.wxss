.favorite-page{background:#f7f6f2;min-height:100vh;padding:0 32rpx 48rpx}.fav-card{background:#fff;border-radius:28rpx;display:-webkit-flex;display:-ms-flexbox;display:flex;gap:24rpx;margin-bottom:24rpx;padding:24rpx}.fav-image{-ms-flex-negative:0;background:#f0f1eb;border-radius:20rpx;-webkit-flex-shrink:0;flex-shrink:0;height:260rpx;width:220rpx}.fav-info{display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex:1;-ms-flex:1;flex:1;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;min-width:0}.fav-name{-webkit-line-clamp:2;-webkit-box-orient:vertical;display:-webkit-box;font-size:28rpx;font-weight:500;line-height:1.55;overflow:hidden;text-overflow:ellipsis}.fav-price-row{-ms-flex-align:baseline;-webkit-align-items:baseline;align-items:baseline;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-wrap:wrap;-ms-flex-wrap:wrap;flex-wrap:wrap;gap:12rpx;margin-top:24rpx}.fav-price{color:#a66845;font-family:DIN Alternate,-apple-system,sans-serif;font-size:36rpx;font-variant-numeric:tabular-nums;font-weight:600}.fav-original{color:#8b958e;font-size:22rpx;text-decoration:line-through}.fav-actions{-ms-flex-align:center;-ms-flex-pack:justify;-webkit-align-items:center;align-items:center;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-wrap:wrap;-ms-flex-wrap:wrap;flex-wrap:wrap;gap:16rpx;-webkit-justify-content:space-between;justify-content:space-between;margin-top:auto;padding-top:24rpx}.action-btn{color:#8b958e;font-size:22rpx}.cart-btn{-ms-flex-align:center;-ms-flex-pack:center;-webkit-align-items:center;align-items:center;background:transparent;border:1rpx solid #244a3d;border-radius:20rpx;border-radius:12rpx;color:#244a3d;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-justify-content:center;justify-content:center;min-height:80rpx;min-height:58rpx;padding:0 16rpx;-webkit-transition:opacity .16s ease;transition:opacity .16s ease}.cart-btn:active{opacity:.7}.cart-btn-text{font-size:23rpx}