.order-list-page{background:#f7f6f2;min-height:100vh;padding:0 32rpx 48rpx}.order-list-page .goods-item{border-bottom:1rpx solid #e5e7df;display:-webkit-flex;display:-ms-flexbox;display:flex;gap:24rpx;padding:24rpx 0}.order-list-page .goods-item:last-child{border:0;padding-bottom:0}.order-list-page .goods-image{-ms-flex-negative:0;background:#f0f1eb;border-radius:16rpx;-webkit-flex-shrink:0;flex-shrink:0;height:160rpx;width:160rpx}.order-list-page .goods-info{-ms-flex-pack:justify;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex:1;-ms-flex:1;flex:1;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;-webkit-justify-content:space-between;justify-content:space-between;min-width:0}.order-list-page .goods-name{-webkit-line-clamp:2;-webkit-box-orient:vertical;display:-webkit-box;font-size:28rpx;font-weight:500;line-height:1.55;overflow:hidden;text-overflow:ellipsis}.order-list-page .goods-meta{-ms-flex-align:center;-ms-flex-pack:justify;-webkit-align-items:center;align-items:center;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-justify-content:space-between;justify-content:space-between;margin-top:20rpx}.order-list-page .goods-price{color:#a66845;font-family:DIN Alternate,-apple-system,sans-serif;font-size:30rpx;font-variant-numeric:tabular-nums;font-weight:600}.order-list-page .goods-qty{color:#8b958e;font-size:24rpx}.order-list-page .tabs{border-bottom:1rpx solid #e5e7df;display:-webkit-flex;display:-ms-flexbox;display:flex;margin-bottom:28rpx;white-space:nowrap;width:100%}.order-list-page .tabs .tab-item{-ms-flex-pack:center;color:#6d7971;display:-webkit-inline-flex;display:-ms-inline-flexbox;display:inline-flex;-webkit-flex:1;-ms-flex:1;flex:1;font-size:26rpx;-webkit-justify-content:center;justify-content:center;padding:24rpx 20rpx;position:relative}.order-list-page .tabs .tab-item.active{color:#244a3d;font-weight:600}.order-list-page .tabs .tab-item.active::after{background:#244a3d;border-radius:5rpx;bottom:0;content:"";height:5rpx;left:26%;position:absolute;right:26%}.order-list-page .tabs .tab-item{-webkit-flex:0 0 auto;-ms-flex:0 0 auto;flex:0 0 auto;padding-left:16rpx;padding-right:16rpx;white-space:nowrap}.order-list-page .tabs .tab-text{white-space:nowrap}.order-card{background:#fff;border-radius:28rpx;margin-bottom:24rpx;padding:28rpx}.order-card-header{-ms-flex-align:center;-ms-flex-pack:justify;-webkit-align-items:center;align-items:center;display:-webkit-flex;display:-ms-flexbox;display:flex;gap:20rpx;-webkit-justify-content:space-between;justify-content:space-between;padding-bottom:4rpx}.order-no{color:#6d7971;-webkit-flex:1;-ms-flex:1;flex:1;font-size:22rpx;min-width:0;word-break:break-all}.order-status{-ms-flex-negative:0;color:#a66845;-webkit-flex-shrink:0;flex-shrink:0;font-size:24rpx}.order-card-footer{border-top:1rpx solid #e5e7df;margin-top:28rpx;padding-top:24rpx;text-align:right}.order-total{color:#6d7971;font-size:24rpx}.total-amount{color:#a66845;font-family:DIN Alternate,-apple-system,sans-serif;font-size:30rpx;font-variant-numeric:tabular-nums;font-weight:600;margin-left:8rpx}