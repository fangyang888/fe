lex:1;-ms-flex:1;flex:1;font-size:28rpx;font-weight:500;-webkit-justify-content:center;justify-content:center;margin-left:12rpx;min-height:88rpx;padding:0 32rpx;-webkit-transition:opacity .16s ease;transition:opacity .16s ease}.detail-add-cart-btn:active{opacity:.7}.add-cart-text{font-size:28rpx}.detail-add-cart-btn.is-disabled{background:#8b958e}