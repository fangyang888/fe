.settings-page{background:#f7f6f2;min-height:100vh;padding:0 32rpx 48rpx}.group{background:#fff;border-radius:28rpx;padding:0 32rpx}.cell{-ms-flex-align:center;-webkit-align-items:center;align-items:center;border-bottom:1rpx solid #e5e7df;display:-webkit-flex;display:-ms-flexbox;display:flex;gap:24rpx;min-height:112rpx;padding:32rpx 0}.cell:last-child{border:0}.cell .ui-icon{height:40rpx;width:40rpx}.cell-text{-webkit-flex:1;-ms-flex:1;flex:1;font-size:28rpx}.cell-arrow{color:#8b958e;font-size:38rpx}.logout-btn{-ms-flex-align:center;-ms-flex-pack:center;-webkit-align-items:center;align-items:center;background:transparent;border:1rpx solid #a45442;border-radius:20rpx;color:#244a3d;color:#a45442;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-justify-content:center;justify-content:center;margin-top:56rpx;min-height:80rpx;padding:0 28rpx;-webkit-transition:opacity .16s ease;transition:opacity .16s ease}.logout-btn:active{opacity:.7}.logout-text{font-size:28rpx}.settings-version{color:#8b958e;display:block;font-size:22rpx;letter-spacing:1rpx;margin-top:160rpx;text-align:center}