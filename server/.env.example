# MySQL 配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=fangyang6579
DB_NAME=fe_prediction

# Redis 缓存（可选，配置后 HotPickPredictor 会缓存重计算结果）
REDIS_URL=redis://localhost:6379

# 服务端口
PORT=3000

# LangChain 单 Agent（OPENAI_BASE_URL 可留空使用 OpenAI 官方地址）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=

# 可选：独立 ELK Agent（默认关闭，原有公开聊天不会获得 ELK 工具）
ELK_MCP_ENABLED=false
ELK_MCP_URL=http://127.0.0.1:3101/mcp
# 与 elk-log-mcp/.env 中的服务令牌相同；不要使用 Kibana 密码。
ELK_MCP_TOKEN=
# 允许使用个人 Kibana 会话的唯一已登录用户 ID（JWT userId），必须明确配置。
ELK_MCP_OPERATOR_USER_ID=
# 可选：用户未提供 host 时优先使用；必须同时出现在上面的白名单中。
ELK_MCP_DEFAULT_HOST=
# 可选：精确业务域名白名单，逗号分隔；路径统计留空时按 Kibana 登录权限查询，search_logs 仍要求白名单。
ELK_MCP_ALLOWED_HOSTS=elk-mcp-check.invalid,elk-mcp-repeat.invalid


# 微信小程序（本地开发可留空走 DEV_OPENID 兜底，上线必须填）
WX_APPID=
WX_SECRET=
DEV_OPENID=dev_openid_0001

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN_SEC=604800

# 微信支付 V3（小程序 JSAPI）。本地开发可全部留空：未配齐时
# 后端返回 mock 参数，前端跳过真实拉起、直接按支付成功处理。
# 上线前必须填齐，且 appid 复用上面的 WX_APPID。
WXPAY_MCHID=                # 商户号
WXPAY_API_V3_KEY=          # APIv3 密钥（32 位，商户平台设置）
WXPAY_SERIAL_NO=           # 商户 API 证书序列号
# 商户 API 私钥（PEM）。整段写一行，换行用 \n 转义
WXPAY_PRIVATE_KEY=
# 支付结果回调地址，需公网可访问的 https
WXPAY_NOTIFY_URL=https://your-domain.com/api/order/pay/notify
